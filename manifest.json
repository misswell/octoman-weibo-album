{
  "manifest_version": 3,
  "name": "Octo微博相册批量下载",
  "version": "0.3.4",
  "description":"一键下载微博相册的插件",
  "background": {
    "service_worker": "background.js"
  },
  "icons":{
    "16": "img/logo.png",
    "48": "img/logo.png",
    "128": "img/logo.png"
  },
  "action": {
    "default_icon": {
      "19": "img/logo.png",
      "38": "img/logo.png"
    },
    "default_title": "Octo微博相册批量下载",
    "default_popup": "popup.html"
  },
  "permissions": [
    "downloads",
    "cookies",
    "declarativeNetRequest",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.weibo.com/*",
    "*://*.weibo.cn/*",
    "*://*.sinaimg.cn/*",
    "*://*.sinajs.cn/*",
    "*://*.liuguofeng.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "weibo_referer",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "options_page": "/options/options.html",
  "optional_permissions": [],
  "content_scripts": [
    {
      "matches": [
        "*://*.weibo.com/*"
      ],
      "js": [
        "jquery/jquery-3.4.1.js",
        "jquery/jquery.cookie.js",
        "jquery/jquery.toast.js",
        "utils/config.js",
        "utils/date.js",
        "utils/util.js",
        "utils/common.js",
        "content/listener.js"
      ],
      "css": [
        "jquery/jquery.toast.css"
      ],
      "run_at": "document_end"
    }
  ]
}
